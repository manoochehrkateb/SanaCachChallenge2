# EditorConfig is awesome: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,md,yml,yaml,xml,csproj,props,targets}]
indent_size = 2

[*.{cs,vb}]
# .NET code style settings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Language style
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:suggestion

# New-line preferences
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Naming conventions
dotnet_naming_rule.interfaces_should_be_pascal_case.symbols = interface_symbols
dotnet_naming_rule.interfaces_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.interfaces_should_be_pascal_case.severity = suggestion
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

[*.cs]
# Keep usings tidy
dotnet_diagnostic.IDE0005.severity = suggestion   # unused using directive
dotnet_diagnostic.CS8019.severity = suggestion    # unused using directive (compiler)
